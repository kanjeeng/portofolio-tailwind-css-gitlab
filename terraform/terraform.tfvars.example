# Salin menjadi terraform.tfvars lalu sesuaikan
aws_region     = "ap-southeast-1"
project_name   = "portofolio-cicd"

# Ganti dengan IP publik Anda:  curl -s https://checkip.amazonaws.com
developer_cidr = "203.0.113.10/32"

developer_public_key_path = "~/.ssh/gitlab-infra-runner.pub"
deploy_public_key_path    = "~/.ssh/gitlab-infra-deploy.pub"

runner_instance_type = "t3.small"
deploy_instance_type = "t3.micro"
