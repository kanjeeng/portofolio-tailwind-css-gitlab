# Salin menjadi terraform.tfvars lalu sesuaikan
aws_region      = "ap-southeast-1"
instance_type   = "t3.micro"
# Sesuaikan absolute path dari key public nya
public_key_path = "~/.ssh/aws-infra-dev.pub"

# Opsional: default 0.0.0.0/0 agar GitHub-hosted runner (IP dinamis) dapat masuk
# ssh_allowed_cidrs = ["0.0.0.0/0"]
